# Copy to .env; never commit real credentials. Restart after changing settings.
OPENAI_API_KEY=
# Choose a Responses model available to the team's API project.
OPENAI_BACKEND_MODEL=gpt-5.6-terra
# The voice model is gpt-live-1; no legacy Realtime configuration is used.
GITHUB_REPOSITORY=vaishnavJa/Chatty
# GitHub owner: use gh auth login or your chosen server-side token integration.
# GH_TOKEN=
# GITHUB_TOKEN=
CHATTY_PORT=3000
# Directory is relative to the repository, or an absolute path.
CHATTY_WEB_DIR=web
